# Telemetry settings only; merge with your existing backend environment.
# This file contains no application credentials and is not loaded automatically.
# From the repository root, export these settings before running the backend:
#   set -a; . ./backend/telemetry.env.example; set +a
#   cd backend/server && cargo run --locked
# Existing backend/.env supplies the other required application settings.

# Uppercase INFO (default) includes TRACE, DEBUG, INFO, WARN and ERROR events.
# WARN includes WARN/ERROR; ERROR includes ERROR only. RUST_LOG is ignored.
# Spans and metrics remain enabled at every accepted level.
LOG_LEVEL=INFO

# Empty/missing/whitespace means local mode: JSON logs on stderr,
# spans and metrics on stdout. An explicit empty value overrides backend/.env.
# A nonblank HTTP/HTTPS URI enables OTLP gRPC logs, traces AND metrics.
# Your receiver needs all three ingestion services; HTTP-only OTLP is insufficient.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Host backend -> receiver published on the host:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Container backend -> receiver service named collector on the same Docker network:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
# The existing Compose files do not provision a collector service.
# Docker Desktop container -> receiver on the host:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317

# Optional service resource name; default is chaos-server.
OTEL_SERVICE_NAME=chaos-server
# Positive integer seconds for hardware sampling and periodic metric export.
# CPU sampling warms up for one interval; missing sensors are omitted.
TELEMETRY_INTERVAL_SECS=5

# Invalid nonblank endpoints, blank/unsupported LOG_LEVEL and invalid intervals
# fail startup. A valid but unreachable receiver does not block startup/requests.
# Settings are read at startup: restart the process after changing them.
# Compose environment changes require recreating the backend container;
# `docker compose restart` alone does not apply changed environment configuration.
